{
  "name": "anki-hebrew-card-creation",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*",
    "#tests/*": "./tests/*"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "HOST=127.0.0.1 BODY_SIZE_LIMIT=8M node --env-file-if-exists=.env build",
    "build-index": "node scripts/build-index.ts",
    "launch-agent": "node scripts/launch-agent.ts",
    "self-update": "git pull --ff-only && npm ci && npm run build && npm run build-index && npm run launch-agent restart",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "biome ci --error-on-warnings .",
    "format": "biome check --write .",
    "test": "svelte-kit sync && vitest run"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@biomejs/biome": "2.6.8",
    "@sveltejs/adapter-node": "^6.0.5",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^24.19.2",
    "jsdom": "^31.0.1",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "5.1.1",
    "zod": "^4.6.7"
  }
}
