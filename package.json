{
  "name": "anki-hebrew-card-creation",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "HOST=127.0.0.1 node --env-file-if-exists=.env build",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "biome ci --error-on-warnings .",
    "format": "biome check --write .",
    "test": "svelte-kit sync && vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "4.1.11"
  }
}
